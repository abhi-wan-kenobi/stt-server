# Tailscale sidecar — mint an auth key at https://login.tailscale.com/admin/settings/keys
# (tagged `tag:stt-server`, reusable). Grant the tag in your tailnet ACLs:
#   "tagOwners": { "tag:stt-server": ["autogroup:admin"] }
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxx
TS_HOSTNAME=stt

# Shared-secret gate on /v1/listen + model mutation routes (optional but recommended
# once exposed on the tailnet). Set the same value in your client's "Custom STT server"
# api_key field.
STT_TOKEN=change-me-to-a-long-random-string

# Host directory bind-mounted into the container as /models. Default below
# matches the coruscant dev deploy; override for your machine.
STT_MODEL_HOST_DIR=/home/skywalker/stt-models
