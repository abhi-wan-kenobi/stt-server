# stt-server — Vulkan GPU image (AMD / Intel / NVIDIA-via-Vulkan).
#
# This is the AMD production path (the ROCm experiment was reverted — see
# docs/architecture.md §"Why Vulkan, not ROCm"). transcribe.cpp's ggml Vulkan
# backend covers AMD RDNA2/3, Intel Arc, and NVIDIA via Vulkan.
#
#   docker build -f apps/stt-server/Dockerfile.vulkan -t stt-server:vulkan .
#   docker run --rm -p 8383:8383 --device /dev/dri --group-add video \
#     -v stt-models:/data/models stt-server:vulkan
#
# RDNA2 (RX 6600 etc.): if silent CPU fallback is detected, the admin panel
# surfaces a `CPU Fallback` state. Run with STT_REQUIRE_GPU=true to fail
# startup if Vulkan isn't working.
#
# NOTE: ubuntu:24.04 (not bookworm) is required because whisper-rs rev 129b982
# uses vk::LayerSettingEXT (Vulkan-Hpp 1.3.275+). Ubuntu 24.04's libvulkan-dev
# is 1.3.275; bookworm's is 1.3.239 (too old). Matches the Notare working recipe.

FROM ubuntu:24.04 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.95.0
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup component add rustfmt

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake clang libclang-dev pkg-config libssl-dev ca-certificates \
    libasound2-dev libudev-dev libpulse-dev libpipewire-0.3-dev \
    libvulkan-dev glslc glslang-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . .
RUN cargo build --release -p stt-server --features vulkan && \
    cp target/release/stt-server /usr/local/bin/stt-server

FROM ubuntu:24.04 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 curl libvulkan1 mesa-vulkan-drivers \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --uid 10001 stt
COPY --from=builder /usr/local/bin/stt-server /usr/local/bin/stt-server
RUN mkdir -p /data/models && chown -R stt:stt /data
VOLUME ["/data"]
USER stt
ENV STT_HOST=0.0.0.0 STT_PORT=8383 STT_MODEL_DIR=/data/models \
    STT_REQUIRE_GPU=true RUST_LOG=info
EXPOSE 8383
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
    CMD curl -f "http://localhost:${STT_PORT}/health" || exit 1
ENTRYPOINT ["/usr/local/bin/stt-server"]
